# API Keys (Required to enable respective provider)
ANTHROPIC_API_KEY="your_anthropic_api_key_here"       # Required: Format: sk-ant-api03-...
PERPLEXITY_API_KEY="your_perplexity_api_key_here"     # Optional: Format: pplx-...
OPENAI_API_KEY="your_openai_api_key_here"             # Optional, for OpenAI models. Format: sk-proj-...
GOOGLE_API_KEY="your_google_api_key_here"             # Optional, for Google Gemini models.
MISTRAL_API_KEY="your_mistral_key_here"               # Optional, for Mistral AI models.
XAI_API_KEY="YOUR_XAI_KEY_HERE"                       # Optional, for xAI AI models.
GROQ_API_KEY="YOUR_GROQ_KEY_HERE"                     # Optional, for Groq models.
OPENROUTER_API_KEY="YOUR_OPENROUTER_KEY_HERE"         # Optional, for OpenRouter models.
AZURE_OPENAI_API_KEY="your_azure_key_here"            # Optional, for Azure OpenAI models (requires endpoint in .taskmaster/config.json).
OLLAMA_API_KEY="your_ollama_api_key_here"             # Optional: For remote Ollama servers that require authentication.
GITHUB_API_KEY="your_github_api_key_here"             # Optional: For GitHub import/export features. Format: ghp_... or github_pat_...
NAVER_CLIENT_ID="your_naver_apihub_client_id"         # Optional: 네이버 API 허브(ncloud) 검색 — 용어 그라운딩(FR-STR-069). 미설정 시 그라운딩만 비활성.
NAVER_CLIENT_SECRET="your_naver_apihub_client_secret"

# ── 데이터 미러 (로컬 전용) ─────────────────────────────────────────────
# 정본(source of truth)은 프로덕션. 로컬에 아래를 설정하면 scheduler가 시작 시 +
# 매일 프로덕션 parquet을 pull 하여 항상 동일하게 유지한다(npm run pull-data 수동도 가능).
# ※ 프로덕션에는 절대 설정하지 말 것(자기 자신을 미러하게 됨).
DATA_MIRROR_REMOTE="root@137.220.41.38:/opt/simons"   # Optional(로컬): 정본 프로덕션 위치
DATA_MIRROR_SSH_KEY="~/.ssh/vultr_simons"             # Optional(로컬): SSH 키 경로
# ── LangSmith 관찰 계층 (기본 비활성) ───────────────────────────────────
# Agent 실행(Planner → Action DAG → Tool → State → Responder)을 Trace로 남긴다.
# 관찰 전용 — 실행 경로·되묻기·폴백 판정을 바꾸지 않는다(backend/observability/).
#
# ⚠ 켜면 사용자 원문·전략 State·LLM 프롬프트 전문이 LangSmith로 전송된다.
#    LANGSMITH_TRACING을 설정하지 않으면 완전한 no-op이다(전송도 오버헤드도 없음).
LANGSMITH_TRACING=""                                  # Optional: "true"일 때만 추적 활성
LANGSMITH_API_KEY="your_langsmith_api_key_here"       # Optional: 추적 활성 시 필수. Format: lsv2_pt_...
LANGSMITH_PROJECT="NullStock"                         # Optional: 기본 "NullStock"
# ⚠ ENDPOINT는 **워크스페이스 리전과 반드시 일치**해야 한다. 틀리면 모든 인증 요청이
#   403 Forbidden으로 떨어지는데, 인증 없이 부르면 401이라 "키는 인식되고 권한만 없다"로
#   읽혀 계정 문제로 오진하기 쉽다(2026-08-01 실측: 키 3개를 새로 발급하며 헤맴).
#   대시보드 주소로 리전을 확인하고 api. 접두를 붙인다:
#     smith.langchain.com(US) → 비워 두거나 https://api.smith.langchain.com
#     eu.smith.langchain.com  → https://eu.api.smith.langchain.com
#     apac.smith.langchain.com→ https://apac.api.smith.langchain.com
LANGSMITH_ENDPOINT=""                                 # Optional: 리전/self-hosted 주소(미설정 시 US SaaS)

# 이메일 가입(테스트용 한시 기능) 킬 스위치 — "off"면 가입·이메일 로그인 페이지=랜딩 리다이렉트, API=404.
# 미설정=켜짐. prod에서 끄기: .env에 off 추가 후 docker compose up -d (재빌드 불필요)
EMAIL_SIGNUP_ENABLED=""
# 가입 인증번호 단계 스위치 — "off"면 인증번호 없이 가입(테스트 기간용). 미설정=인증 요구.
# 비밀번호 정책·레이트리밋·중복 확인·약관 동의는 off여도 그대로 강제된다.
EMAIL_SIGNUP_VERIFICATION=""

# 이메일 가입 인증 메일(SMTP) — 미설정 시: 개발=콘솔에 인증번호 출력, 프로덕션=발송 실패(가입 차단)
SMTP_HOST=""                                          # 예: smtp.gmail.com
SMTP_PORT="587"                                       # 465면 TLS(secure)
SMTP_USER=""
SMTP_PASS=""                                          # Gmail이면 앱 비밀번호
SMTP_FROM=""                                          # Optional: 발신 표시 주소(기본 SMTP_USER)
