# 브라우저 트래픽은 전부 Next.js(web:3000)로 보낸다.
# FastAPI 백엔드(backend:8000)는 Next 서버가 내부에서만 호출하므로 외부 노출하지 않는다.
# DOMAIN 환경변수는 compose가 .env에서 주입한다 (예: DOMAIN=simons.example.com).
# 로컬 테스트 시 DOMAIN 미설정이면 localhost로 동작(자체서명 인증서).
{$DOMAIN:localhost} {
	reverse_proxy web:3000
}

# apex(www 없는) 도메인을 canonical(www) 호스트로 영구 리다이렉트한다.
# 미설정 시 apex.localhost로 동작(내부 인증서) — 로컬 compose에서 ACME 발급 시도 방지.
# 예: APEX_DOMAIN=nullstock.im → https://www.nullstock.im 로 리다이렉트(+ apex 인증서 발급).
{$APEX_DOMAIN:apex.localhost} {
	redir https://{$DOMAIN:localhost}{uri} permanent
}
