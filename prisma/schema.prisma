generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BacktestHistory {
  id           String   @id @default(cuid())
  strategyName String
  universe     String
  conditions   String
  metrics      String
  createdAt    DateTime @default(now())
}

model BacktestResult {
  id         String   @id @default(cuid())
  strategyId String
  stockId    Int?
  summary    String
  trades     String?
  createdAt  DateTime @default(now())
  Strategy   Strategy @relation(fields: [strategyId], references: [id])
  Stock      Stock?   @relation(fields: [stockId], references: [id])
}

model Stock {
  id             Int              @id @default(autoincrement())
  symbol         String           @unique
  name           String?
  market         String?
  updatedAt      DateTime
  BacktestResult BacktestResult[]
}

model Strategy {
  id             String           @id @default(cuid())
  name           String
  description    String?
  settings       String
  strategyType   String           @default("기타")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  BacktestResult BacktestResult[]
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime
}

model VirtualAccount {
  id                 String              @id
  name               String
  initialCash        Float
  currentCash        Float
  strategyId         String?
  strategyName       String?
  tradingMode        String              @default("manual")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  VirtualMarketState VirtualMarketState?
  VirtualOrder       VirtualOrder[]
  VirtualPosition    VirtualPosition[]
}

model VirtualMarketLog {
  id         String   @id
  accountId  String
  date       String
  symbol     String
  signalType String
  reason     String?
  price      Float
  action     String
  orderId    String?
  createdAt  DateTime @default(now())
}

model VirtualMarketState {
  id             String         @id
  accountId      String         @unique
  startDate      String
  status         String         @default("stopped")
  symbols        String
  lastRefreshed  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VirtualOrder {
  id             String         @id
  accountId      String
  symbol         String
  name           String?
  side           String
  type           String
  quantity       Int
  price          Float
  filledPrice    Float?
  status         String
  filledAt       DateTime?
  createdAt      DateTime       @default(now())
  avgBuyPrice    Float?
  fee            Float?
  realizedPnl    Float?
  tax            Float?
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VirtualPosition {
  id             String         @id
  accountId      String
  symbol         String
  name           String
  quantity       Int
  avgPrice       Float
  currentPrice   Float?
  openedAt       DateTime       @default(now())
  updatedAt      DateTime
  peakPrice      Float?
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
}

model WatchlistGroup {
  id              String            @id
  name            String
  color           String            @default("#3B82F6")
  createdAt       DateTime          @default(now())
  WatchlistSymbol WatchlistSymbol[]
}

model WatchlistSymbol {
  id             String          @id
  symbol         String          @unique
  name           String
  addedAt        DateTime        @default(now())
  groupId        String?
  WatchlistGroup WatchlistGroup? @relation(fields: [groupId], references: [id])
}
