generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BacktestHistory {
  id           String   @id @default(cuid())
  strategyId   String?
  strategyName String
  universe     String
  conditions   String
  metrics      String
  result       String?
  cacheKey     String?  @unique
  isVisible    Boolean  @default(false)
  hitCount     Int      @default(0)
  createdAt    DateTime @default(now())
  Strategy     Strategy? @relation(fields: [strategyId], references: [id])

  @@index([strategyId, createdAt])
}

model BacktestResult {
  id         String   @id @default(cuid())
  strategyId String
  stockId    Int?
  summary    String
  trades     String?
  createdAt  DateTime @default(now())
  Strategy   Strategy @relation(fields: [strategyId], references: [id])
  Stock      Stock?   @relation(fields: [stockId], references: [id])

  @@index([strategyId, createdAt])
}

model Stock {
  id             Int              @id @default(autoincrement())
  symbol         String           @unique
  name           String?
  market         String?
  sector         String?
  industry       String?
  description    String?
  listingDate    String?
  profileSource  String?
  profileUpdatedAt DateTime?
  updatedAt      DateTime
  infoProfile    StockInfoProfile?
  BacktestResult BacktestResult[]
}

model StockInfoProfile {
  symbol                String   @id
  source                String?
  companyBasicJson      String?
  summaryFinancialsJson String?
  pe                    Float?
  pbr                   Float?
  debtRatio             Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  stock                 Stock    @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
}

model Strategy {
  id             String           @id
  name           String
  description    String?
  settings       String
  strategyType   String           @default("기타")
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  BacktestResult BacktestResult[]
  BacktestHistory BacktestHistory[]
  BatchRunCandidate BatchRunCandidate[]
}

model BatchRun {
  id              String              @id
  createdAt       DateTime            @default(now())
  totalPrompts    Int
  completedCount  Int                 @default(0)
  failedCount     Int                 @default(0)
  skippedCount    Int                 @default(0)
  rankingSnapshot String
  logs            String?
  Candidate       BatchRunCandidate[]

  @@index([createdAt])
}

model BatchRunCandidate {
  id           String    @id @default(cuid())
  runId        String
  strategyId   String?
  prompt       String
  strategyName String
  status       String
  errorMessage String?
  metrics      String?
  rank         Int?
  createdAt    DateTime  @default(now())
  BatchRun     BatchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  Strategy     Strategy? @relation(fields: [strategyId], references: [id])

  @@index([runId, createdAt])
  @@index([runId, status])
  @@index([strategyId])
}

model User {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  name        String
  password    String
  planTier    String        @default("FREE")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime
  ResearchRun ResearchRun[]
}

model ResearchRun {
  id              String              @id @default(cuid())
  userId          Int
  status          String              @default("PENDING")
  goal            String?
  config          String
  holdoutStart    String
  seed            Int
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  errorMessage    String?
  totalCandidates Int                 @default(0)
  promotedCount   Int                 @default(0)
  User            User                @relation(fields: [userId], references: [id])
  Candidate       ResearchCandidate[]
  Event           ResearchEvent[]

  @@index([userId, status])
}

model ResearchCandidate {
  id                String      @id @default(cuid())
  runId             String
  dslHash           String
  dslJson           String
  template          String
  stage             String      @default("GENERATED")
  rejectionReason   String?
  prescreenMetrics  String?
  wfaResult         String?
  mcResult          String?
  optunaBest        String?
  holdoutMetrics    String?
  compositeScore    Float?
  robustnessScore   Float?
  deflatedSharpe    Float?
  promotedAccountId String?
  createdAt         DateTime    @default(now())
  ResearchRun       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, dslHash])
  @@index([runId, stage])
  @@index([runId, compositeScore])
}

model ResearchEvent {
  id          String      @id @default(cuid())
  runId       String
  candidateId String?
  level       String      @default("INFO")
  event       String
  payload     String
  createdAt   DateTime    @default(now())
  ResearchRun ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model VirtualAccount {
  id                 String              @id
  name               String
  initialCash        Float
  currentCash        Float
  strategyId         String?
  strategyName       String?
  tradingMode        String              @default("manual")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  VirtualMarketState VirtualMarketState?
  VirtualOrder       VirtualOrder[]
  VirtualPosition    VirtualPosition[]
}

model VirtualMarketLog {
  id         String   @id
  accountId  String
  date       String
  symbol     String
  signalType String
  reason     String?
  price      Float
  action     String
  orderId    String?
  createdAt  DateTime @default(now())
}

model VirtualMarketState {
  id             String         @id
  accountId      String         @unique
  startDate      String
  status         String         @default("stopped")
  symbols        String
  lastRefreshed  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VirtualOrder {
  id             String         @id
  accountId      String
  symbol         String
  name           String?
  side           String
  type           String
  quantity       Int
  price          Float
  filledPrice    Float?
  status         String
  filledAt       DateTime?
  createdAt      DateTime       @default(now())
  avgBuyPrice    Float?
  fee            Float?
  realizedPnl    Float?
  tax            Float?
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VirtualPosition {
  id             String         @id
  accountId      String
  symbol         String
  name           String
  quantity       Int
  avgPrice       Float
  currentPrice   Float?
  openedAt       DateTime       @default(now())
  updatedAt      DateTime
  peakPrice      Float?
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
}

model SearchCount {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  name      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WatchlistGroup {
  id              String            @id
  name            String
  color           String            @default("#3B82F6")
  createdAt       DateTime          @default(now())
  WatchlistSymbol WatchlistSymbol[]
}

model WatchlistSymbol {
  id             String          @id
  symbol         String          @unique
  name           String
  addedAt        DateTime        @default(now())
  groupId        String?
  WatchlistGroup WatchlistGroup? @relation(fields: [groupId], references: [id])
}

// ─── News Impact AI Agent ─────────────────────────────────────────────────────

model NewsArticle {
  id            String              @id @default(cuid())
  title         String
  summary       String?
  url           String              @unique
  source        String
  author        String?
  publishedAt   DateTime
  crawledAt     DateTime            @default(now())
  category      String?
  language      String              @default("ko")
  bodyHash      String?
  canonicalId   String?
  isCanonical   Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  RawArticles   NewsArticleRaw[]
  SymbolMaps    NewsArticleSymbol[]
  Event         NewsEvent?
  Impact        NewsImpact?
  Signals       NewsSignal[]

  @@index([publishedAt])
  @@index([source, publishedAt])
  @@index([canonicalId])
}

model NewsArticleRaw {
  id            String       @id @default(cuid())
  articleId     String?
  provider      String
  externalId    String?
  title         String
  body          String?
  url           String
  source        String
  author        String?
  publishedAt   DateTime
  category      String?
  rawJson       String
  crawledAt     DateTime     @default(now())
  NewsArticle   NewsArticle? @relation(fields: [articleId], references: [id])

  @@index([provider, crawledAt])
  @@index([articleId])
  @@index([url])
}

model NewsArticleSymbol {
  id          String      @id @default(cuid())
  articleId   String
  symbol      String
  companyName String?
  scope       String      @default("stock")
  sector      String?
  relevance   Float       @default(1.0)
  createdAt   DateTime    @default(now())
  NewsArticle NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([symbol])
  @@index([symbol, createdAt])
}

model NewsEvent {
  id               String      @id @default(cuid())
  articleId        String      @unique
  eventType        String
  sentiment        String
  severity         Float       @default(0.5)
  surprise         Float       @default(0.0)
  credibility      Float       @default(0.5)
  novelty          Float       @default(0.5)
  relevance        Float       @default(0.5)
  summary          String?
  riskFlags        String?
  affectedEntities String?
  expectedHorizon  String?
  modelVersion     String      @default("v1")
  createdAt        DateTime    @default(now())
  NewsArticle      NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([createdAt])
}

model NewsImpact {
  id                 String      @id @default(cuid())
  articleId          String      @unique
  symbol             String?
  impactDirection    String
  impactScore        Float
  confidenceScore    Float
  expectedHorizon    String
  expectedAlpha1d    Float?
  expectedAlpha5d    Float?
  volatilityJumpRisk Float?
  riskAlertLevel     String
  modelVersion       String      @default("v1")
  createdAt          DateTime    @default(now())
  NewsArticle        NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([symbol, createdAt])
  @@index([riskAlertLevel])
}

model NewsSignal {
  id           String      @id @default(cuid())
  articleId    String
  symbol       String
  signalType   String
  value        Float
  direction    String
  confidence   Float
  validFrom    DateTime
  validUntil   DateTime?
  metadata     String?
  modelVersion String      @default("v1")
  createdAt    DateTime    @default(now())
  NewsArticle  NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([symbol, validFrom])
  @@index([symbol, signalType])
}

model NewsIngestionLog {
  id           String    @id @default(cuid())
  provider     String
  startedAt    DateTime
  finishedAt   DateTime?
  status       String
  fetched      Int       @default(0)
  deduplicated Int       @default(0)
  inserted     Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())

  @@index([provider, createdAt])
}
