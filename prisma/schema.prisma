generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model BacktestHistory {
  id           String   @id @default(cuid())
  strategyId   String?
  strategyName String
  prompt       String?
  universe     String
  conditions   String
  metrics      String
  result       String?
  cacheKey     String?  @unique
  isVisible    Boolean  @default(false)
  hitCount     Int      @default(0)
  createdAt    DateTime @default(now())
  Strategy     Strategy? @relation(fields: [strategyId], references: [id])
  UserBacktestHistory UserBacktestHistory[]

  @@index([strategyId, createdAt])
}

// 사용자별 "내 백테스트 목록" — 공유 BacktestHistory(중복 방지 캐시)를 그대로 두고
// 어떤 사용자가 자신의 목록에 담았는지만 기록한다. 목록에서 삭제하면 이 조인 row만
// 지우고 공유 결과는 보존된다.
model UserBacktestHistory {
  id                String          @id @default(cuid())
  userId            Int
  backtestHistoryId String
  savedAt           DateTime        @default(now())
  User              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  BacktestHistory   BacktestHistory @relation(fields: [backtestHistoryId], references: [id], onDelete: Cascade)

  @@unique([userId, backtestHistoryId])
  @@index([userId, savedAt])
}

model BacktestResult {
  id         String   @id @default(cuid())
  strategyId String?
  stockId    Int?
  summary    String
  trades     String?
  createdAt  DateTime @default(now())
  Strategy   Strategy? @relation(fields: [strategyId], references: [id], onDelete: SetNull)
  Stock      Stock?   @relation(fields: [stockId], references: [id])

  @@index([strategyId, createdAt])
}

// 전략 최적화(워크포워드·몬테카를로) 검증 결과를 사용자가 명시적으로 저장한 스냅샷.
// 목록은 summary(경량 요약)만 읽고, 불러오기 시 result(전체 JSON)를 조회한다.
model SavedValidation {
  id           String   @id @default(cuid())
  userId       Int?
  modelType    String   // "walkForward" | "monteCarlo"
  strategyName String
  prompt       String?
  cacheKey     String?  // 원본 백테스트 결과 식별(같은 전략 묶기용)
  settings     String   // 실행 설정 스냅샷 JSON
  result       String   // 검증 결과 전체 JSON (재렌더용)
  summary      String?  // 목록 표시용 핵심 지표 JSON
  createdAt    DateTime @default(now())
  User         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, cacheKey])
}

model Stock {
  id               Int              @id @default(autoincrement())
  symbol           String           @unique
  name             String?
  market           String?
  sector           String?
  industry         String?
  description      String?
  listingDate      String?
  profileSource    String?
  profileUpdatedAt DateTime?
  updatedAt        DateTime
  // Listing status fields
  listingStatus    String           @default("NORMAL")
  suspensionReason String?
  delistingDate    String?
  lastTradableDate String?
  riskFlags        String?          // JSON array of risk flag strings
  statusUpdatedAt  DateTime?
  infoProfile      StockInfoProfile?
  BacktestResult   BacktestResult[]

  @@index([listingStatus])
}

model StockInfoProfile {
  symbol                String   @id
  source                String?
  companyBasicJson      String?
  summaryFinancialsJson String?
  pe                    Float?
  pbr                   Float?
  debtRatio             Float?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  stock                 Stock    @relation(fields: [symbol], references: [symbol], onDelete: Cascade)
}

model Strategy {
  id             String           @id
  userId         Int?
  name           String
  description    String?
  settings       String
  strategyType   String           @default("기타")
  isSaved        Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  User           User?            @relation(fields: [userId], references: [id])
  BacktestResult BacktestResult[]
  BacktestHistory BacktestHistory[]
  BacktestRun    BacktestRun[]
  BatchRunCandidate BatchRunCandidate[]
  StrategyEmbedding StrategyEmbedding[]
  AdviceExperience AdviceExperience[]

  @@index([userId, createdAt])
}

model BacktestRun {
  id                   String   @id @default(cuid())
  strategyId           String
  market               String?
  universe             String?
  timeframe            String   @default("1d")
  startDate            String?
  endDate              String?
  initialCapital       Float
  commissionBps        Float    @default(0)
  slippageBps          Float    @default(0)
  liquidityPolicy      String?
  universeSnapshotHash String?
  resultMetrics        String
  monthlyReturns       String?
  rollingMetrics       String?
  oosMetrics           String?
  walkForwardResult    String?
  tradeStats           String?
  status               String   @default("completed")
  cacheKey             String   @unique
  hitCount             Int      @default(0)
  createdAt            DateTime @default(now())
  Strategy             Strategy @relation(fields: [strategyId], references: [id])

  @@index([strategyId])
  @@index([strategyId, createdAt])
}

model StrategyEmbedding {
  id            String   @id @default(cuid())
  strategyId    String
  embeddingType String
  sourceText    String
  vector        Bytes?
  sparseTokens  String?
  modelName     String
  createdAt     DateTime @default(now())
  Strategy      Strategy @relation(fields: [strategyId], references: [id])

  @@index([strategyId])
  @@index([embeddingType])
}

model AdviceExperience {
  id                 String   @id @default(cuid())
  strategyId         String
  createdAt          DateTime @default(now())
  market             String?
  universe           String?
  initialCapital     Float
  timeframe          String   @default("1d")
  userPrompt         String
  strategySummary    String?
  strategyDsl        String
  canonicalDsl       String
  strategyHash       String
  similarStrategyIds String
  retrievedCases     String
  agentAdvice        String
  beforeBacktest     String
  afterBacktest      String?
  evaluation         String
  lesson             String
  confidence         String
  dataCoverage       String?
  Strategy           Strategy @relation(fields: [strategyId], references: [id])

  @@index([strategyId])
  @@index([market, universe])
  @@index([confidence])
}

model BatchRun {
  id              String              @id
  createdAt       DateTime            @default(now())
  totalPrompts    Int
  completedCount  Int                 @default(0)
  failedCount     Int                 @default(0)
  skippedCount    Int                 @default(0)
  rankingSnapshot String
  logs            String?
  Candidate       BatchRunCandidate[]

  @@index([createdAt])
}

model BatchRunCandidate {
  id           String    @id @default(cuid())
  runId        String
  strategyId   String?
  prompt       String
  strategyName String
  status       String
  errorMessage String?
  metrics         String?
  rank            Int?
  backtestRequest String?
  createdAt       DateTime  @default(now())
  BatchRun        BatchRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  Strategy        Strategy? @relation(fields: [strategyId], references: [id])

  @@index([runId, createdAt])
  @@index([runId, status])
  @@index([strategyId])
}

model StrategyPromptExperiment {
  id               String                              @id
  name             String
  seed             Int
  totalPrompts     Int
  status           String
  config           String
  summary          String?
  resultFilePath   String?
  summaryFilePath  String?
  datasetFilePath  String?
  rulesFilePath    String?
  patternsFilePath String?
  createdAt        DateTime                            @default(now())
  updatedAt        DateTime                            @updatedAt
  candidates       StrategyPromptExperimentCandidate[]
  insights         StrategyAdvisorLearningInsight[]

  @@index([createdAt])
  @@index([status])
}

model StrategyPromptExperimentCandidate {
  id                  String                   @id @default(cuid())
  experimentId        String
  promptId            String
  prompt              String
  category            String
  complexity          String
  riskProfile         String
  expectedBlocks      String
  parsedStrategy      String?
  strategyDsl         String?
  strategyId          String?
  status              String
  errorType           String?
  errorMessage        String?
  metrics             String?
  qualityScore        Float?
  extractedBlocks     String?
  extractedParameters String?
  coachLearningTags   String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  experiment          StrategyPromptExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@unique([experimentId, promptId])
  @@index([experimentId, createdAt])
  @@index([experimentId, status])
  @@index([strategyId])
  @@index([category])
}

model StrategyAdvisorLearningInsight {
  id           String                   @id @default(cuid())
  experimentId String
  insightType  String
  key          String
  payload      String
  confidence   String
  createdAt    DateTime                 @default(now())
  experiment   StrategyPromptExperiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)

  @@index([experimentId, insightType])
  @@index([key])
}

model User {
  id             Int              @id @default(autoincrement())
  email          String           @unique
  name           String
  password       String
  planTier       String           @default("FREE")
  role           String           @default("USER") // USER | ADMIN — ADMIN 부여는 DB에서만 (관리자 화면/API로 변경 불가)
  status         String           @default("ACTIVE") // ACTIVE | SUSPENDED | DELETED(soft delete)
  lastLoginAt    DateTime?
  backtestUsageMonth     String?
  backtestCountThisMonth Int       @default(0)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ResearchRun    ResearchRun[]
  Strategy       Strategy[]
  VirtualAccount VirtualAccount[]
  UserAsset      UserAsset?
  AssetLedger    AssetLedger[]
  WatchlistGroup WatchlistGroup[]
  WatchlistSymbol WatchlistSymbol[]
  UserBacktestHistory UserBacktestHistory[]
  SavedValidation SavedValidation[]
}

// 관리자 작업 감사 로그 — 모든 관리자 작업을 기록한다. 삭제 API는 제공하지 않는다.
model AdminAuditLog {
  id           String   @id @default(cuid())
  adminId      Int
  adminEmail   String
  action       String   // 예: USER_PLAN_CHANGE, USER_SUSPEND, ACCOUNT_RESET, ...
  targetType   String?  // USER | VIRTUAL_ACCOUNT | STRATEGY | PLAN | BACKTEST_USAGE
  targetId     String?
  targetUserId Int?
  beforeJson   String?
  afterJson    String?
  ip           String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([adminId, createdAt])
}

// 플랜별 한도 오버라이드 — null이면 lib/plans.ts 기본값 사용.
// maxStrategies는 -1이면 무제한.
model PlanConfig {
  planId               String   @id // FREE | PRO | PREMIUM
  monthlyBacktestLimit Int?
  maxStrategies        Int?
  maxVirtualAccounts   Int?
  updatedAt            DateTime @updatedAt
}

model UserAsset {
  userId             Int      @id
  availableCash      Decimal  @default(10000000)
  initialGrantAmount Decimal  @default(10000000)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  User               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResearchRun {
  id              String              @id @default(cuid())
  userId          Int
  status          String              @default("PENDING")
  goal            String?
  config          String
  holdoutStart    String
  seed            Int
  startedAt       DateTime            @default(now())
  finishedAt      DateTime?
  errorMessage    String?
  totalCandidates Int                 @default(0)
  promotedCount   Int                 @default(0)
  User            User                @relation(fields: [userId], references: [id])
  Candidate       ResearchCandidate[]
  Event           ResearchEvent[]

  @@index([userId, status])
}

model ResearchCandidate {
  id                String      @id @default(cuid())
  runId             String
  dslHash           String
  dslJson           String
  template          String
  stage             String      @default("GENERATED")
  rejectionReason   String?
  prescreenMetrics  String?
  wfaResult         String?
  mcResult          String?
  optunaBest        String?
  holdoutMetrics    String?
  compositeScore    Float?
  robustnessScore   Float?
  deflatedSharpe    Float?
  promotedAccountId String?
  createdAt         DateTime    @default(now())
  ResearchRun       ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, dslHash])
  @@index([runId, stage])
  @@index([runId, compositeScore])
}

model ResearchEvent {
  id          String      @id @default(cuid())
  runId       String
  candidateId String?
  level       String      @default("INFO")
  event       String
  payload     String
  createdAt   DateTime    @default(now())
  ResearchRun ResearchRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, createdAt])
}

model VirtualAccount {
  id                 String              @id
  userId             Int?
  name               String
  initialCash        Decimal
  currentCash        Decimal
  status             String              @default("ACTIVE")
  strategyId         String?
  strategyName       String?
  tradingMode        String              @default("manual")
  delistingPolicy    String              @default("AUTO_LIQUIDATE")
  createdAt          DateTime            @default(now())
  updatedAt          DateTime
  closedAt           DateTime?
  User               User?               @relation(fields: [userId], references: [id])
  VirtualMarketState VirtualMarketState?
  VirtualOrder       VirtualOrder[]
  VirtualPosition    VirtualPosition[]
  DelistingAuditLog  DelistingAuditLog[]
  AssetLedger        AssetLedger[]

  @@index([userId, createdAt])
  @@index([userId, status])
}

model AssetLedger {
  id             String          @id @default(cuid())
  userId         Int
  accountId      String?
  type           String
  amount         Decimal
  balanceAfter   Decimal
  createdAt      DateTime        @default(now())
  User           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  VirtualAccount VirtualAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([accountId, createdAt])
  @@index([type])
}

model VirtualMarketLog {
  id         String   @id
  accountId  String
  date       String
  symbol     String
  stockName  String?
  signalType String
  reason     String?
  price      Float
  action     String
  orderId    String?
  createdAt  DateTime @default(now())
}

model VirtualMarketState {
  id             String         @id
  accountId      String         @unique
  startDate      String
  status         String         @default("stopped")
  symbols        String
  lastRefreshed  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VirtualOrder {
  id             String         @id
  accountId      String
  symbol         String
  name           String?
  side           String
  type           String
  quantity       Int
  price          Decimal
  filledPrice    Decimal?
  status         String
  filledAt       DateTime?
  createdAt      DateTime       @default(now())
  avgBuyPrice    Decimal?
  fee            Decimal?
  realizedPnl    Decimal?
  tax            Decimal?
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
}

model VirtualPosition {
  id             String         @id
  accountId      String
  symbol         String
  name           String
  quantity       Int
  avgPrice       Decimal
  currentPrice   Decimal?
  openedAt       DateTime       @default(now())
  updatedAt      DateTime
  peakPrice      Decimal?
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, symbol])
}

model SearchCount {
  id        Int      @id @default(autoincrement())
  symbol    String   @unique
  name      String
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model WatchlistGroup {
  id              String            @id
  userId          Int?
  name            String
  color           String            @default("#3B82F6")
  createdAt       DateTime          @default(now())
  User            User?             @relation(fields: [userId], references: [id])
  WatchlistSymbol WatchlistSymbol[]

  @@index([userId, createdAt])
}

model WatchlistSymbol {
  id             String          @id
  userId         Int?
  symbol         String
  name           String
  addedAt        DateTime        @default(now())
  groupId        String?
  User           User?           @relation(fields: [userId], references: [id])
  WatchlistGroup WatchlistGroup? @relation(fields: [groupId], references: [id])

  @@unique([userId, symbol])
  @@index([userId, addedAt])
}

// ─── News Fetch Cache ─────────────────────────────────────────────────────────

model NewsFetchCache {
  symbol        String    @id
  fetchedAt     DateTime
  articleCount  Int       @default(0)
  isFetching    Boolean   @default(false)
  fetchingUntil DateTime?
  updatedAt     DateTime  @updatedAt
}

// ─── News Impact AI Agent ─────────────────────────────────────────────────────

model NewsArticle {
  id            String              @id @default(cuid())
  title         String
  summary       String?
  url           String              @unique
  source        String
  author        String?
  publishedAt   DateTime
  crawledAt     DateTime            @default(now())
  category      String?
  language      String              @default("ko")
  bodyHash      String?
  canonicalId   String?
  isCanonical   Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  RawArticles   NewsArticleRaw[]
  SymbolMaps    NewsArticleSymbol[]
  Event         NewsEvent?
  Impact        NewsImpact?
  Signals       NewsSignal[]

  @@index([publishedAt])
  @@index([source, publishedAt])
  @@index([canonicalId])
}

model NewsArticleRaw {
  id            String       @id @default(cuid())
  articleId     String?
  provider      String
  externalId    String?
  title         String
  body          String?
  url           String
  source        String
  author        String?
  publishedAt   DateTime
  category      String?
  rawJson       String
  crawledAt     DateTime     @default(now())
  NewsArticle   NewsArticle? @relation(fields: [articleId], references: [id])

  @@index([provider, crawledAt])
  @@index([articleId])
  @@index([url])
}

model NewsArticleSymbol {
  id          String      @id @default(cuid())
  articleId   String
  symbol      String
  companyName String?
  scope       String      @default("stock")
  sector      String?
  relevance   Float       @default(1.0)
  createdAt   DateTime    @default(now())
  NewsArticle NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([symbol])
  @@index([symbol, createdAt])
}

model NewsEvent {
  id               String      @id @default(cuid())
  articleId        String      @unique
  eventType        String
  sentiment        String
  severity         Float       @default(0.5)
  surprise         Float       @default(0.0)
  credibility      Float       @default(0.5)
  novelty          Float       @default(0.5)
  relevance        Float       @default(0.5)
  summary          String?
  riskFlags        String?
  affectedEntities String?
  expectedHorizon  String?
  modelVersion     String      @default("v1")
  createdAt        DateTime    @default(now())
  NewsArticle      NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([createdAt])
}

model NewsImpact {
  id                 String      @id @default(cuid())
  articleId          String      @unique
  symbol             String?
  impactDirection    String
  impactScore        Float
  confidenceScore    Float
  expectedHorizon    String
  expectedAlpha1d    Float?
  expectedAlpha5d    Float?
  volatilityJumpRisk Float?
  riskAlertLevel     String
  modelVersion       String      @default("v1")
  createdAt          DateTime    @default(now())
  NewsArticle        NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([symbol, createdAt])
  @@index([riskAlertLevel])
}

model NewsSignal {
  id           String      @id @default(cuid())
  articleId    String
  symbol       String
  signalType   String
  value        Float
  direction    String
  confidence   Float
  validFrom    DateTime
  validUntil   DateTime?
  metadata     String?
  modelVersion String      @default("v1")
  createdAt    DateTime    @default(now())
  NewsArticle  NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([symbol, validFrom])
  @@index([symbol, signalType])
}

model NewsIngestionLog {
  id           String    @id @default(cuid())
  provider     String
  startedAt    DateTime
  finishedAt   DateTime?
  status       String
  fetched      Int       @default(0)
  deduplicated Int       @default(0)
  inserted     Int       @default(0)
  error        String?
  createdAt    DateTime  @default(now())

  @@index([provider, createdAt])
}

// ─── News v2 — Pre-fetch & Cache architecture ─────────────────────────────────
//
// Standalone tables for the new pre-fetched, tier-scheduled, Redis-cached news
// pipeline that powers the stock-page news tab. Designed to be PostgreSQL-native
// (run on SQLite for dev with JSON-as-string fallbacks).

model NewsV2Article {
  id              Int       @id @default(autoincrement())
  symbol          String
  title           String
  normalizedTitle String
  summary         String?
  source          String
  url             String
  publishedAt     DateTime
  sentiment       String?
  sentimentScore  Float?
  impactLevel     String?
  marketEffect    String?
  relatedSymbols  String?
  aiSummary       String?
  embedding       Bytes?
  hash            String
  status          String    @default("analyzed")
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([symbol, hash])
  @@index([symbol, publishedAt])
  @@index([hash])
  @@index([publishedAt])
}

model NewsRaw {
  newsId          String   @id
  title           String
  normalizedTitle String
  titleHash       String
  url             String   @unique
  source          String
  publishedAt     DateTime
  rawContent      String?
  contentQuality  Float    @default(0)
  createdAt       DateTime @default(now())

  @@index([publishedAt])
  @@index([titleHash])
  @@index([source, publishedAt])
  @@map("news_raw")
}

model NewsAnalysisV2 {
  newsId         String   @id
  sentiment      String?
  impactScore    Float?
  importance     String?
  summary        String?
  marketEffect   String?
  relatedSymbols String?
  status         String   @default("analyzed")
  error          String?
  analyzedAt     DateTime @default(now())

  @@index([analyzedAt])
  @@map("news_analysis")
}

model NewsSymbolMapV2 {
  id          Int      @id @default(autoincrement())
  newsId      String
  symbol      String
  companyName String?
  relevance   Float    @default(1)
  evidence    String?
  createdAt   DateTime @default(now())

  @@unique([newsId, symbol])
  @@index([symbol])
  @@index([newsId])
  @@map("news_symbol_map")
}

model StockNewsCache {
  id          Int      @id @default(autoincrement())
  symbol      String
  newsId      String
  publishedAt DateTime
  rankScore   Float    @default(0)
  cachedAt    DateTime @default(now())

  @@unique([symbol, newsId])
  @@index([symbol, publishedAt])
  @@index([symbol, rankScore])
  @@map("stock_news_cache")
}

model NewsV2PriorityScore {
  symbol          String   @id
  score           Float    @default(0)
  tier            Int      @default(3)
  queue           String   @default("cold")
  reason          String?
  isTrending      Boolean  @default(false)
  lastCollected   DateTime?
  lastViewed      DateTime?
  currentViewUntil DateTime?
  viewCount24h    Int      @default(0)
  watchlistCount  Int      @default(0)
  holdingCount    Int      @default(0)
  searchCount24h  Int      @default(0)
  volatility      Float    @default(0)
  turnover        Float    @default(0)
  marketCap       Float    @default(0)
  tradingValue    Float    @default(0)
  newsCount1h     Int      @default(0)
  newsCount24h    Int      @default(0)
  newsVelocity    Float    @default(0)
  indexMember     Int      @default(0)
  aiImportance    Float    @default(0)
  updatedAt       DateTime @updatedAt

  @@index([tier, score])
  @@index([queue, score])
  @@index([isTrending, score])
}

model NewsV2PriorityEvent {
  id           Int      @id @default(autoincrement())
  symbol       String
  eventType    String
  userId       String?
  weight       Float    @default(1)
  metadataJson String?
  createdAt    DateTime @default(now())

  @@index([symbol, createdAt])
  @@index([eventType, createdAt])
}

model NewsV2CollectionQueueItem {
  symbol      String   @id
  queue       String
  score       Float    @default(0)
  reason      String?
  isTrending  Boolean  @default(false)
  enqueuedAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([queue, score])
  @@index([updatedAt])
}

model NewsV2CollectionStatus {
  symbol         String    @id
  status         String    @default("NOT_COLLECTED")
  lastSuccessAt  DateTime?
  lastAttemptAt  DateTime?
  lastError      String?
  attemptCount   Int       @default(0)
  inFlightJobId  String?
  updatedAt      DateTime  @updatedAt
}

model NewsV2IngestionLog {
  id          Int       @id @default(autoincrement())
  symbol      String
  provider    String
  jobId       String?
  startedAt   DateTime
  finishedAt  DateTime?
  fetched     Int       @default(0)
  deduped     Int       @default(0)
  inserted    Int       @default(0)
  status      String
  error       String?

  @@index([symbol, startedAt])
}

// ─── Delisting Risk Management ────────────────────────────────────────────────

model DelistingAuditLog {
  id             String         @id @default(cuid())
  accountId      String
  symbol         String
  actionType     String         // AUTO_LIQUIDATE | TRADE_BLOCKED | STATUS_CHANGE | FORCED_HOLD
  previousStatus String?
  newStatus      String?
  quantity       Int?
  executionPrice Float?
  reason         String?
  createdAt      DateTime       @default(now())
  VirtualAccount VirtualAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([symbol, createdAt])
}
