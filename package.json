{
  "name": "simons-stock-investment",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "concurrently --names \"next,backend,scheduler\" --prefix-colors \"cyan,green,yellow\" \"npm run dev\" \"npm run dev:backend\" \"npm run dev:scheduler\"",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "sync-stocks": "ts-node scripts/sync-korea-stocks.ts",
    "sync-data": "python3 scripts/sync_data.py",
    "dev:backend": "python3 -m uvicorn main:app --host 0.0.0.0 --port 8000 --reload --reload-dir backend --app-dir backend",
    "dev:scheduler": "python3 scripts/scheduler.py",
    "start-scheduler": "python3 scripts/scheduler.py",
    "test:frontend": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@tanstack/react-table": "^8.21.3",
    "@visx/axis": "^3.12.0",
    "@visx/brush": "^3.12.0",
    "@visx/curve": "^3.12.0",
    "@visx/event": "^3.12.0",
    "@visx/gradient": "^3.12.0",
    "@visx/grid": "^3.12.0",
    "@visx/group": "^3.12.0",
    "@visx/responsive": "^3.12.0",
    "@visx/scale": "^3.12.0",
    "@visx/shape": "^3.12.0",
    "@visx/tooltip": "^3.12.0",
    "@visx/xychart": "^3.12.0",
    "axios": "^1.6.2",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "date-fns": "^3.0.6",
    "framer-motion": "^12.27.0",
    "jsonwebtoken": "^9.0.2",
    "lightweight-charts": "^5.0.9",
    "next": "14.0.4",
    "parquetjs-lite": "^0.8.7",
    "phosphor-react": "^1.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "recharts": "^2.10.3",
    "tailwind-merge": "^3.4.0",
    "task-master-ai": "^0.42.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.4",
    "@types/react": "18.3.26",
    "@types/react-dom": "^18.2.18",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "eslint-config-next": "14.0.4",
    "iconv-lite": "^0.7.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.32",
    "prisma": "^5.7.1",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.3",
    "vitest": "^3.0.0",
    "vitest-tsconfig-paths": "^3.4.1",
    "xlsx": "^0.18.5"
  }
}
