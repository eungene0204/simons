# ─────────────────────────────────────────────────────────────────────────────
# Vultr 앱 박스 프로덕션 .env (하이브리드: 앱=Vultr CPU, LLM=Modal GPU)
# 박스에서 이 파일을 .env로 복사하고 값을 채운다.  시크릿을 깃에 커밋하지 말 것.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM (Modal serverless GPU) ───────────────────────────────────────────────
# 배포된 Modal Ollama 엔드포인트 + Proxy Auth 토큰(웹 Settings에서 생성)
OLLAMA_HOST=https://eugene204--simons-ollama-ollama-server.modal.run
MODAL_KEY=wk-...            # Modal-Key (proxy auth token id)
MODAL_SECRET=ws-...        # Modal-Secret (proxy auth token secret)
# 앱이 요청하는 모델 — Modal이 서빙하는 것과 반드시 동일(modal_ollama.py MODELS)
NL_OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M
# AI 리포트(백테스트 총평) 전용 모델 — 파서와 분리. 미설정 시 NL_OLLAMA_MODEL로 폴백.
SUMMARIZE_OLLAMA_MODEL=hf.co/unsloth/Qwen3.5-9B-GGUF:Q4_K_M

# ── 백테스트 (Modal serverless CPU 워커) ─────────────────────────────────────
# 사용자 백테스트(/backtest, /strategy/backtest-stream)를 Modal 워커에서 실행(오토스케일).
# 미설정 시 인프로세스 실행(로컬 dev 기본). 인증은 위 MODAL_KEY/MODAL_SECRET 재사용.
# 데이터 볼륨 동기화: 데이터 갱신 후 박스에서 `bash scripts/sync_modal_backtest_data.sh`
BACKTEST_EXECUTOR=modal
BACKTEST_REMOTE_URL=https://eugene204--simons-backtest-run-backtest.modal.run

# ── 앱 DB (Supabase Postgres, pooler 경유 — Vultr는 IPv4-only라 Direct connection 불가) ──
DATABASE_URL=postgresql://postgres.ydyvilnpmiadinmsoecu:<password>@aws-0-us-west-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.ydyvilnpmiadinmsoecu:<password>@aws-0-us-west-1.pooler.supabase.com:5432/postgres
NEWSV2_PG_PASSWORD=                        # news_v2 전용 로컬 Postgres 컨테이너 비밀번호(임의 난수, Supabase 아님)

# ── 인증/보안 (임의 난수) ─────────────────────────────────────────────────────
JWT_SECRET=
SCHEDULER_SECRET=

# ── 외부 데이터 API ──────────────────────────────────────────────────────────
KRX_API_KEY=
KIS_APP_KEY=
KIS_APP_SECRET=
DART_API_KEY=
PUBLIC_DATA_SERVICE_KEY=
NAVER_CLIENT_ID=           # 네이버 API 허브(ncloud) — 용어 그라운딩 검색(FR-STR-069)
NAVER_CLIENT_SECRET=
GOOGLE_API_KEY=            # (옵션) LLM 보조 — 로컬/Modal Ollama 전제면 미사용 가능
STITCH_API_KEY=           # (옵션)

# ── 프론트 인증 (Supabase) ───────────────────────────────────────────────────
# ⚠ NEXT_PUBLIC_* 는 `docker compose build` 시점에 클라이언트 번들로 인라인된다.
#   비워두고 빌드하면 브라우저에서 구글 로그인 버튼이 무반응이 된다(런타임 주입 불가).
#   값을 채운 뒤 반드시 재빌드: docker compose build && docker compose up -d
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 토스페이먼츠 (유료 플랜 자동결제/빌링) ──────────────────────────────────
# API 개별 연동 키 사용(결제위젯 키는 빌링 미지원). 실결제 전 반드시 자동결제(빌링)
# 계약이 완료된 상점의 라이브 키로 교체 — 미계약 키는 NOT_SUPPORTED_METHOD 에러
TOSS_SECRET_KEY=
NEXT_PUBLIC_TOSS_CLIENT_KEY=

# ── PayPal 정기구독 (글로벌 /us 서비스, USD) ────────────────────────────────
# 미설정 시 글로벌 유료 플랜 CTA는 준비 중으로 표시된다. 기본 API는 sandbox.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_API_BASE=           # 라이브: https://api-m.paypal.com (미설정 시 sandbox)
# 웹훅 서명 검증 키 — PayPal 개발자 대시보드에 웹훅 URL을 등록하면 발급된다.
# 이 값이 없으면 위조된 웹훅으로 플랜을 승격시킬 수 있으므로 실결제 전 필수.
PAYPAL_WEBHOOK_ID=
# 빌링 플랜 ID — scripts/paypal-create-plans.ts로 생성한다(플랜당 1개, 사용자별 아님).
PAYPAL_PLAN_PRO=
PAYPAL_PLAN_PREMIUM=

# ── 배포 도메인 (Namecheap DNS → Caddy 자동 TLS) ────────────────────────────
DOMAIN=                    # 예: www.nullstock.im nullstock.im (미설정 시 Caddy는 localhost 자체서명)
APEX_DOMAIN=               # 예: nullstock.im (apex→www 301 리다이렉트)
